{
  "name": "request-neo",
  "version": "1.0.0",
  "description": "A Flask/FastAPI-flavored Node.js HTTP framework: protocol, routing, validation, middleware, real-time (WebSocket & SSE), security, and observability. Powered By Vexify 2026.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "bin"],
  "bin": {
    "request-neo": "./bin/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "prepublishOnly": "npm run build",
    "test": "node test/e2e.test.js",
    "start": "node examples/server.js"
  },
  "keywords": ["http", "framework", "router", "websocket", "sse", "openapi", "middleware", "flask", "fastapi"],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}